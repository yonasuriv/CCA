# Stage outputs (per-run artifacts, not part of the workspace definition)
**/stages/*/output/*
!**/stages/*/output/.gitkeep

# The worked example's current-state handoff is a versioned fixture:
# it is linked from CONTEXT.md and log.md, so a fresh checkout must contain it.
!examples/workspaces/topic-research/stages/*/output/2026-08-11-collect-notes.md

# Workspace-builder stage outputs (intermediate build artifacts)
workspaces/workspace-builder/stages/*/output/*
!workspaces/workspace-builder/stages/*/output/.gitkeep

# Third-Party vendor local settings
.agents/
.claude/
.opencode/
.pi/

# Node dependencies
node_modules/

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Editor files
*.swp
*.swo
*~
.vscode/settings.json
.obsidian/

# Environment files
.env
.env.local

# Cloned reference repos (local only)
*-ref/
.tmp/

# Python tooling (if scripts are added)
__pycache__/
*.pyc

# Other artifacts
evals/archive/

# Keep stage outputs out of history by default — they are per-run products.
# Uncomment to version them (ICM practice: commit after each run for a versioned pipeline history):
# stages/*/output/*
# !stages/*/.gitkeep
